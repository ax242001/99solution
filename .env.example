# -----------------------------------------------------------------------------
# 99solution Contact Form Email & SMTP Configuration
# -----------------------------------------------------------------------------

# Recipient Email address (where contact requests will be forwarded)
CONTACT_RECIPIENT_EMAIL="ax242001@aol.com"

# SMTP Server Settings (Works with Resend SMTP, Gmail, AOL, SendGrid, Zoho, Mailgun, etc.)
# If using Resend:
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="resend"
# SMTP_PASS="re_your_resend_api_key"

# If using Gmail SMTP:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-google-app-password"

# If using AOL SMTP:
# SMTP_HOST="smtp.aol.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-aol-username@aol.com"
# SMTP_PASS="your-aol-app-password"

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM='"99solution Web Helpdesk" <notifications@99solution.ng>'
